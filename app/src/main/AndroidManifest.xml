<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <permission
        android:name="dev.noxen.playground.permission.MY_CUSTOM_PERMISSION"
        android:protectionLevel="normal" />

    <permission
        android:name="dev.noxen.playground.permission.SIGNATURE_PERMISSION"
        android:protectionLevel="signature" />

    <permission
        android:name="dev.noxen.playground.permission.DANGEROUS_PERMISSION"
        android:protectionLevel="dangerous" />

    <uses-permission android:name="dev.noxen.playground.permission.MY_CUSTOM_PERMISSION" />
    <uses-permission android:name="dev.noxen.playground.permission.SIGNATURE_PERMISSION" />
    <uses-permission android:name="dev.noxen.playground.permission.DANGEROUS_PERMISSION" />
    <!-- Intentionally not defined by any package: noxen shows it as "unresolved". -->
    <uses-permission android:name="dev.noxen.playground.permission.UNDEFINED_PERMISSION" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NoxenPlayground">

        <service
            android:name=".Service1"
            android:enabled="true"
            android:exported="true" />
        <receiver
            android:name=".Receiver2"
            android:enabled="true"
            android:exported="true"
            android:permission="dev.noxen.playground.permission.MY_CUSTOM_PERMISSION" />
        <receiver
            android:name=".Receiver1"
            android:enabled="true"
            android:exported="true" />

        <!-- Permission scenarios for the Info app tab (Access: weak / open). -->
        <receiver
            android:name=".DangerousPermissionReceiver"
            android:exported="true"
            android:permission="dev.noxen.playground.permission.DANGEROUS_PERMISSION" />
        <receiver
            android:name=".UnresolvedPermissionReceiver"
            android:exported="true"
            android:permission="dev.noxen.playground.permission.UNDEFINED_PERMISSION" />

        <!-- android:permission on a provider sets both read and write (Access: protected). -->
        <provider
            android:name=".SignatureProvider"
            android:authorities="dev.noxen.playground.signature"
            android:exported="true"
            android:permission="dev.noxen.playground.permission.SIGNATURE_PERMISSION" />

        <!-- Split read/write plus a path-permission that opens /public reads (Access: open). -->
        <provider
            android:name=".SplitPermissionProvider"
            android:authorities="dev.noxen.playground.split"
            android:exported="true"
            android:grantUriPermissions="false"
            android:readPermission="dev.noxen.playground.permission.SIGNATURE_PERMISSION"
            android:writePermission="dev.noxen.playground.permission.DANGEROUS_PERMISSION">
            <path-permission
                android:pathPrefix="/public"
                android:readPermission="dev.noxen.playground.permission.MY_CUSTOM_PERMISSION" />
            <grant-uri-permission android:pathPrefix="/shared" />
        </provider>

        <activity
            android:name=".Activity9"
            android:exported="false" />
        <activity
            android:name=".Activity8"
            android:exported="true">
            <intent-filter>
                <action android:name="dev.noxen.playground.action.ATTACK_TEST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name=".Activity7"
            android:exported="false" />
        <activity
            android:name=".Activity6"
            android:exported="false" />
        <activity
            android:name=".Activity5"
            android:exported="false"
            android:launchMode="singleTask" />
        <activity
            android:name=".Activity4"
            android:exported="false" />
        <activity
            android:name=".Activity2"
            android:exported="false" />
        <activity
            android:name=".Activity1"
            android:exported="false" />
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
